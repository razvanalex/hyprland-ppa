#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked || cargo build --release

override_dh_auto_install:
	install -D -m 0755 target/release/airpods-tui debian/airpods-tui/usr/bin/airpods-tui
	install -D -m 0644 airpods-tui.service debian/airpods-tui/usr/lib/systemd/user/airpods-tui.service
	install -D -m 0644 README.md debian/airpods-tui/usr/share/doc/airpods-tui/README.md

override_dh_dwz:
	# Ignore dwz compression for Rust binaries
